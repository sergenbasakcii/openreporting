# /etc/openreporting/openreporting.env — root:openreporting 0640. Read by openreporting-web, openreporting-worker and openreporting-backup.
# Values here are defaults suitable for an Ubuntu server behind nginx (HTTPS).

OPENREPORTING_DATA_DIR=/var/lib/openreporting
OPENREPORTING_SECRET_KEY_FILE=/etc/openreporting/secret.key
OPENREPORTING_COOKIE_SECURE=true
OPENREPORTING_SESSION_HOURS=12
# New production installs require authenticator enrollment for admins.
# Empty = optional; comma-separated admin,editor,viewer. Existing enabled factors always apply.
OPENREPORTING_MFA_REQUIRED_ROLES=admin
OPENREPORTING_PUBLIC_URL=https://openreporting.example.com
# PUBLIC_URL hostname and loopback are trusted automatically; list other exact DNS/IP aliases.
# No wildcard or port in this list. Unknown Host headers are rejected.
OPENREPORTING_ALLOWED_HOSTS=

# Web tier: uvicorn worker processes and trusted proxy headers from local nginx.
OPENREPORTING_WEB_WORKERS=2
OPENREPORTING_PROXY_HEADERS=true

# Query safety budgets
OPENREPORTING_QUERY_TIMEOUT_MS=30000
OPENREPORTING_MAX_ROWS=200000
OPENREPORTING_QUERY_CONCURRENCY=6
OPENREPORTING_MAX_SERIES_POINTS=2000000

# Report archive retention in days (0 = keep forever)
OPENREPORTING_REPORT_RETENTION_DAYS=365

# Synthetic TestData datasource for learning/templates (set false in strict production)
OPENREPORTING_PROVISION_TESTDATA=true

# Allow plain-http Zabbix/Postgres endpoints (NOT recommended; keep false)
OPENREPORTING_ALLOW_HTTP_DATASOURCES=false
# HTTP sources (Prometheus/Loki/JSON/CSV) may not reach this server's own localhost services by default.
OPENREPORTING_ALLOW_LOOPBACK_DATASOURCES=false

# --- E-mail delivery (off until staging-tested) ---
OPENREPORTING_MAIL_ENABLED=false
OPENREPORTING_SMTP_HOST=
OPENREPORTING_SMTP_PORT=587
OPENREPORTING_SMTP_STARTTLS=true
# starttls = mandatory upgrade (usually 587); tls = implicit TLS (usually 465).
# Both verify certificate chain + hostname. No plaintext/downgrade mode when mail is enabled.
OPENREPORTING_SMTP_SECURITY=starttls
OPENREPORTING_SMTP_CA_FILE=
OPENREPORTING_SMTP_TIMEOUT=30
OPENREPORTING_SMTP_LOCAL_HOSTNAME=
OPENREPORTING_SMTP_USER=
OPENREPORTING_SMTP_PASSWORD=
# Prefer a root:openreporting 0640 secret file; do not set both PASSWORD and PASSWORD_FILE.
OPENREPORTING_SMTP_PASSWORD_FILE=
OPENREPORTING_SMTP_FROM=
OPENREPORTING_ALLOWED_RECIPIENT_DOMAINS=

# --- LDAP / Active Directory (off until configured and tested) ---
# ldaps:// (usually 636) or ldap:// (usually 389, mandatory StartTLS).
OPENREPORTING_LDAP_ENABLED=false
OPENREPORTING_LDAP_URL=
OPENREPORTING_LDAP_BIND_DN=
OPENREPORTING_LDAP_BIND_PASSWORD_FILE=
OPENREPORTING_LDAP_BASE_DN=
OPENREPORTING_LDAP_USER_FILTER='(&(objectClass=user)(sAMAccountName={username}))'
OPENREPORTING_LDAP_ID_ATTRIBUTE=objectGUID
OPENREPORTING_LDAP_GROUP_ATTRIBUTE=memberOf
# Exact direct group DNs; highest matching role wins; no matching group = no access.
# OPENREPORTING_LDAP_GROUP_ROLES='{"CN=ReportReaders,OU=Groups,DC=example,DC=com":"viewer","CN=ReportEditors,OU=Groups,DC=example,DC=com":"editor"}'
OPENREPORTING_LDAP_GROUP_ROLES='{}'
OPENREPORTING_LDAP_CA_FILE=
OPENREPORTING_LDAP_TIMEOUT=10
OPENREPORTING_LDAP_SESSION_MINUTES=60

# --- Optional: environment-provisioned Zabbix (otherwise add datasources in the UI) ---
# OPENREPORTING_ZABBIX_URL=https://zabbix.example.com/api_jsonrpc.php
# OPENREPORTING_ZABBIX_TOKEN_FILE=/etc/openreporting/zabbix-token
# OPENREPORTING_ZABBIX_CA_FILE=/usr/local/share/ca-certificates/corporate-ca.crt

