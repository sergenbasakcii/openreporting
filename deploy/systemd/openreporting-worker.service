[Unit]
Description=OpenReporting report worker (single scheduler: PDF/Excel generation, e-mail)
Documentation=file:///opt/openreporting/app/docs/LINUX_DEPLOYMENT.md
After=network-online.target openreporting-web.service
Wants=network-online.target

[Service]
Type=simple
User=openreporting
Group=openreporting
EnvironmentFile=/etc/openreporting/openreporting.env
WorkingDirectory=/var/lib/openreporting
ExecStart=/opt/openreporting/venv/bin/openreporting worker
# An interrupted SMTP exchange is never replayed; the worker quarantines it on start.
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillMode=mixed
UMask=0027
LimitNOFILE=65536
Nice=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/openreporting
ReadOnlyPaths=/etc/openreporting /opt/openreporting

[Install]
WantedBy=multi-user.target
