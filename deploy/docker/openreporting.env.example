# deploy/docker/openreporting.env — copy of this file, read by the web, worker and backup containers.
#   cp deploy/docker/openreporting.env.example deploy/docker/openreporting.env && chmod 600 deploy/docker/openreporting.env
# Data dir, key file and proxy trust are fixed by docker-compose.yml. SMTP, LDAP, MFA roles and
# limits can also be set later in the UI (Yönetim > Sistem ayarları); UI values take precedence.

# Address users type in the browser (https, with :port only if HTTPS is not on 443).
OPENREPORTING_PUBLIC_URL=https://openreporting.example.com
# Other exact DNS names / IPs users may use for the same server (comma separated, no port, no wildcard).
OPENREPORTING_ALLOWED_HOSTS=
OPENREPORTING_COOKIE_SECURE=true
OPENREPORTING_SESSION_HOURS=12
OPENREPORTING_MFA_REQUIRED_ROLES=admin
OPENREPORTING_WEB_WORKERS=2
TZ=Europe/Istanbul

# Query safety budgets
OPENREPORTING_QUERY_TIMEOUT_MS=30000
OPENREPORTING_MAX_ROWS=200000
OPENREPORTING_QUERY_CONCURRENCY=6
OPENREPORTING_MAX_SERIES_POINTS=2000000
OPENREPORTING_REPORT_RETENTION_DAYS=365
OPENREPORTING_PROVISION_TESTDATA=true
OPENREPORTING_ALLOW_HTTP_DATASOURCES=false
OPENREPORTING_ALLOW_LOOPBACK_DATASOURCES=false

# E-mail and LDAP stay off until configured (easiest in the UI).
OPENREPORTING_MAIL_ENABLED=false
OPENREPORTING_LDAP_ENABLED=false

# Backups (docker compose --profile backup run --rm backup)
OPENREPORTING_BACKUP_KEEP_DAYS=14
# true = also copy the encryption key into each backup (keep backups somewhere safe then).
OPENREPORTING_BACKUP_INCLUDE_KEY=false
